# No credentials are required. Never add market-data or TTS keys here.
# Dev permits the ignored local bundle. LOCAL production check only:
# EDISON_EVIDENCE_MODE=local npm run start -- --hostname 127.0.0.1
EDISON_EVIDENCE_MODE=withheld
# Enable only after documenting data-publication rights.
EDISON_PUBLIC_EVIDENCE_APPROVED=false
# Required reference to documented permission, alongside explicit approval.
# EDISON_EVIDENCE_PERMISSION_REF=
# Sends submitted questions to the free Jev endpoint when explicitly enabled.
EDISON_JEV_ENABLED=false
# Optional absolute path to a validated private bundle, outside public/.
# EDISON_EVIDENCE_FILE=
